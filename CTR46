  const nama = document.getElementById('login-nama').value.trim();
  const nisn = document.getElementById('login-nisn').value.trim();
  const valid = VALID_TEACHERS.some(u => u.nama.toLowerCase() === nama.toLowerCase() && u.nisn === nisn);
  if (!valid) {
    const err = document.getElementById('login-error');
    err.textContent = '❌ Kombinasi Nama dan Kode Akses tidak cocok.';
    err.classList.remove('hidden');
    return;
  }
  document.getElementById('login-error').classList.add('hidden');
  document.getElementById('login-page').style.display = 'none';
  document.getElementById('main-page').classList.remove('hidden');
  currentUser = { nama, nisn };
  renderSubjectRows();
  updateSectionVisibility();
});



// Print from form
document.getElementById('print-btn').addEventListener('click', () => {
  const nama = document.getElementById('form-nama').value.trim();
  if (!nama) { showFormMsg('Isi minimal Nama Siswa.', true); return; }
  saveFormToTab(activeTab);
  const storage = tabFormStorage[activeTab];
  const data = {
    nama_siswa: storage.nama,
    nisn: storage.nisn,
    kelas: storage.kelas,
    semester: storage.semester,
    tahun_pelajaran: '2025/2026',
    is_draft: 'false',
    kelas_login: getKelasLogin(),
    ...storage.data,
    catatan_wali_kelas: storage.catatan,
    created_at: new Date().toISOString()
  };
  
  // If Akademik tab, print directly without showing modal
  if (activeTab === 'akademik') {
    printPDF(data);
    return;
  }
  
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50';
  modal.style.backdropFilter = 'blur(4px)';
  modal.innerHTML = `<div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6"><div class="text-center mb-6"><h2 class="text-xl font-bold text-[#1a3a5c] mb-2">📄 Pilih Format</h2><p class="text-sm text-[#4a6d8c]">Pilih cara untuk simpan/cetak rapor</p></div><div class="space-y-3"><button id="form-dl-html" type="button" class="w-full py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="file" style="width:18px;height:18px;"></i> Simpan HTML</button><button id="form-dl-pdf" type="button" class="w-full py-3 bg-purple-500 hover:bg-purple-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="file-pdf" style="width:18px;height:18px;"></i> Buka sebagai PDF</button><button id="form-dl-print" type="button" class="w-full py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="printer" style="width:18px;height:18px;"></i> Cetak Langsung</button><button id="form-dl-cancel" type="button" class="w-full py-3 bg-gray-300 hover:bg-gray-400 text-gray-700 font-semibold rounded-lg">Batal</button></div></div>`;
  document.body.appendChild(modal);
  const html = generatePDFHTML(data);
  const filename = `Rapor_${(data.nama_siswa||'siswa').replace(/\s+/g,'_')}.html`;
  modal.querySelector('#form-dl-html').addEventListener('click', () => {
    const blob = new Blob([html], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url); modal.remove(); showToast('✅ File HTML berhasil diunduh!');
  });
  modal.querySelector('#form-dl-pdf').addEventListener('click', () => {
    const blob = new Blob([html], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank');
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    modal.remove();
    showToast('📄 File PDF dibuka di tab baru');
  });
  modal.querySelector('#form-dl-print').addEventListener('click', () => { printPDF(data); modal.remove(); });
  modal.querySelector('#form-dl-cancel').addEventListener('click', () => modal.remove());
  lucide.createIcons();
});

// Logout
function doLogout() {
  document.getElementById('main-page').classList.add('hidden');
  document.getElementById('login-page').style.display = 'flex';
  currentUser = null;
  clearForm();
}
document.getElementById('logout-btn').addEventListener('click', doLogout);
document.getElementById('header-logout-btn').addEventListener('click', doLogout);

lucide.createIcons();
