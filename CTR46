// Build payload helper - ensures all fields match schema exactly (26 fields, no created_at)
function buildPayload(isDraft = false) {
  // Helper to safely get element value
  const getVal = (id) => {
    const el = document.getElementById(id);
    return el ? String(el.value || '') : '';
  };
  
  // Collect only essential fields to minimize payload size
  const nilaiCapaianData = {};
  for (let i = 1; i <= 19; i++) {
    const n = document.querySelector(`.nilai-input[data-index="${i}"]`);
    const c = document.querySelector(`.capaian-input[data-index="${i}"]`);
    const nVal = n ? String(n.value || '') : '';
    const cVal = c ? String(c.value || '') : '';
    if (nVal) nilaiCapaianData[`n${i}`] = nVal;
    if (cVal) nilaiCapaianData[`c${i}`] = cVal;
  }
  
  // PPI inputs - only store non-empty values
  const ppiObj = {};
  const ppiCharakteristik = String(document.querySelector('.ppi-input[data-field="ppi_karakteristik"]')?.value || '');
  const ppiKekuatan = String(document.querySelector('.ppi-input[data-field="ppi_kekuatan"]')?.value || '');
  const ppiHambatan = String(document.querySelector('.ppi-input[data-field="ppi_hambatan"]')?.value || '');
  const ppiTarget = String(document.querySelector('.ppi-input[data-field="ppi_target"]')?.value || '');
  if (ppiCharakteristik) ppiObj.k = ppiCharakteristik;
  if (ppiKekuatan) ppiObj.s = ppiKekuatan;
  if (ppiHambatan) ppiObj.h = ppiHambatan;
  if (ppiTarget) ppiObj.t = ppiTarget;
  
  // Perkembangan inputs - only store non-empty
  const ppPrefixes = ['komunikasi','sosial','kemandirian','motorik','pengembangan'];
  const perkembanganData = {};
  for (let i = 1; i <= 5; i++) {
    const prefix = ppPrefixes[i-1];
    const awal = document.querySelector(`.pp-awal-input[data-index="${i}"]`);
    const tengah = document.querySelector(`.pp-tengah-input[data-index="${i}"]`);
    const akhir = document.querySelector(`.pp-akhir-input[data-index="${i}"]`);
    const aVal = String(awal?.value || '');
    const tVal = String(tengah?.value || '');
    const akVal = String(akhir?.value || '');
    if (aVal) perkembanganData[`${i}a`] = aVal;
    if (tVal) perkembanganData[`${i}t`] = tVal;
    if (akVal) perkembanganData[`${i}ak`] = akVal;
  }
  
  // LKP inputs - only store non-empty
  const lkpData = {};
  for (let i = 1; i <= 5; i++) {
    const prefix = ppPrefixes[i-1];
    const target = document.querySelector(`.lkp-target-input[data-index="${i}"]`);
    const ketercapaian = document.querySelector(`.lkp-ketercapaian-input[data-index="${i}"]`);
    const deskripsi = document.querySelector(`.lkp-deskripsi-input[data-index="${i}"]`);
    const tVal = String(target?.value || '');
    const kVal = String(ketercapaian?.value || '');
    const dVal = String(deskripsi?.value || '');
    if (tVal) lkpData[`${i}t`] = tVal;
    if (kVal) lkpData[`${i}k`] = kVal;
    if (dVal) lkpData[`${i}d`] = dVal;
  }
  
  // Ekstrakurikuler inputs - only store non-empty
  const ekstraData = {};
  for (let i = 1; i <= 3; i++) {
    const ekstra = document.querySelector(`.ekstrakurikuler-input[data-index="${i}"]`);
    const ket = document.querySelector(`.ekstrakurikuler-ket-input[data-index="${i}"]`);
    const eVal = String(ekstra?.value || '');
    const kVal = String(ket?.value || '');
    if (eVal) ekstraData[`e${i}`] = eVal;
    if (kVal) ekstraData[`ek${i}`] = kVal;
  }
  
  // Prestasi inputs - only store non-empty
  const prestasiData = {};
  for (let i = 1; i <= 3; i++) {
    const prestasi = document.querySelector(`.prestasi-input[data-index="${i}"]`);
    const ket = document.querySelector(`.prestasi-ket-input[data-index="${i}"]`);
    const pVal = String(prestasi?.value || '');
    const kVal = String(ket?.value || '');
    if (pVal) prestasiData[`p${i}`] = pVal;
    if (kVal) prestasiData[`pk${i}`] = kVal;
  }
  
  // Build final payload with guaranteed string values (all 26 schema fields, NO created_at)
  const payload = {
    nama_siswa: getVal('form-nama'),
    nisn: getVal('form-nisn'),
    kelas: getVal('form-kelas'),
    semester: getVal('form-semester'),
    tahun_pelajaran: '2025/2026',
    is_draft: isDraft ? 'true' : 'false',
    kelas_login: getKelasLogin(),
    ketidakhadiran_sakit: getVal('ketidakhadiran-sakit') || '0',
    ketidakhadiran_ijin: getVal('ketidakhadiran-ijin') || '0',
    ketidakhadiran_tanpa: getVal('ketidakhadiran-tanpa') || '0',
    catatan_wali_kelas: getVal('catatan-wali'),
    naik_ke_kelas: getVal('naik-ke-kelas'),
    tinggal_di_kelas: getVal('tinggal-di-kelas'),
    status_kelulusan: getVal('status-kelulusan'),
    nama_guru_pengampu: getVal('guru-nama'),
    nip_guru_pengampu: getVal('guru-nip'),
    nama_wali_kelas: getVal('wali-nama'),
    nip_wali_kelas: getVal('wali-nip'),
    nama_orangtua: getVal('orangtua-nama'),
    nama_kepala_sekolah: getVal('kepala-nama') || 'Dr. DINI HANDAYANI, M. Pd.',
    nip_kepala_sekolah: getVal('kepala-nip') || 'NIP. 198312082011012003',
    ppi_data: JSON.stringify(ppiObj),
    nilai_capaian_data: JSON.stringify(nilaiCapaianData),
    perkembangan_data: JSON.stringify(perkembanganData),
    lkp_data: JSON.stringify(lkpData),
    ekstrakurikuler_data: JSON.stringify(ekstraData),
    prestasi_data: JSON.stringify(prestasiData)
  };
  
  return payload;
}

// Universal save handler
async function handleSaveData(evt) {
  evt.preventDefault();
  const payload = buildPayload(false);
  
  const nama = payload.nama_siswa.trim();
  const nisn = payload.nisn.trim();
  const kelas = payload.kelas.trim();
  const semester = payload.semester.trim();
  
  if (!nama || !nisn || !kelas || !semester) {
    showFormMsg('Isi minimal Nama, NISN, Kelas, dan Semester.', true);
    return;
  }
  if (!sdkReady) {
    showFormMsg('Sistem data belum siap.', true);
    return;
  }
  if (!currentEditingRecord && !currentEditingDraft && (allRecords.length + allDrafts.length) >= 999) {
    showFormMsg('Batas 999 data tercapai.', true);
    return;
  }
  
  const btn = evt.target.closest('button');
  btn.disabled = true;
  const originalHTML = btn.innerHTML;
  btn.innerHTML = '<i data-lucide="check-circle" style="width:20px;height:20px;"></i> <span>Menyimpan...</span>';
  
  try {
    let result;
    if (currentEditingRecord) {
      // Update existing record - only pass __backendId + payload fields
      result = await window.dataSdk.update({ __backendId: currentEditingRecord.__backendId, ...payload });
    } else {
      // Create new record
      result = await window.dataSdk.create(payload);
      if (result.isOk && currentEditingDraft) {
        await window.dataSdk.delete(currentEditingDraft);
      }
    }
    
    if (result.isOk) {
      showToast('✅ Data berhasil disimpan!');
      clearForm();
      currentEditingRecord = null;
      currentEditingDraft = null;
    } else {
      const errorMsg = result.error?.message || 'Gagal menyimpan';
      showFormMsg('❌ ' + errorMsg, true);
      console.error('SDK Create/Update Error:', result.error);
    }
  } catch (err) {
    showFormMsg('❌ ' + err.message, true);
    console.error('Save Error:', err);
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHTML;
    lucide.createIcons();
  }
}

