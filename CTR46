function printPDF(rec) {
  const w = window.open('', '_blank', 'width=900,height=1200');
  w.document.write(generatePDFHTML(rec));
  w.document.close();
  setTimeout(() => w.print(), 500);
}

function downloadPDF(rec) {
  const html = generatePDFHTML(rec);
  const filename = `Rapor_${(rec.nama_siswa||'siswa').replace(/\s+/g,'_')}.html`;
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50';
  modal.style.backdropFilter = 'blur(4px)';
  modal.innerHTML = `<div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6"><div class="text-center mb-6"><h2 class="text-xl font-bold text-[#1a3a5c] mb-2">📥 Pilih Format</h2><p class="text-sm text-[#4a6d8c]">Pilih cara untuk menyimpan rapor</p></div><div class="space-y-3"><button id="dl-html" type="button" class="w-full py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="file" style="width:18px;height:18px;"></i> Simpan HTML</button><button id="dl-pdf" type="button" class="w-full py-3 bg-purple-500 hover:bg-purple-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="file-pdf" style="width:18px;height:18px;"></i> Buka sebagai PDF</button><button id="dl-print" type="button" class="w-full py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg flex items-center justify-center gap-2"><i data-lucide="printer" style="width:18px;height:18px;"></i> Cetak Langsung</button><button id="dl-cancel" type="button" class="w-full py-3 bg-gray-300 hover:bg-gray-400 text-gray-700 font-semibold rounded-lg">Batal</button></div></div>`;
  document.body.appendChild(modal);
  modal.querySelector('#dl-html').addEventListener('click', () => {
    const blob = new Blob([html], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url); modal.remove(); showToast('✅ File HTML berhasil diunduh!');
  });
  modal.querySelector('#dl-pdf').addEventListener('click', () => {
    const blob = new Blob([html], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    window.open(url, '_blank');
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    modal.remove();
    showToast('📄 File PDF dibuka di tab baru');
  });
  modal.querySelector('#dl-print').addEventListener('click', () => { printPDF(rec); modal.remove(); });
  modal.querySelector('#dl-cancel').addEventListener('click', () => modal.remove());
  lucide.createIcons();
}

