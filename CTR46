function switchTab(tab) {
  saveFormToTab(activeTab);
  activeTab = tab;
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  restoreFormFromTab(tab);
  updateSectionVisibility();
  renderRecords();
  renderDrafts();
  updateSaveButtonsVisibility();
}

function updateSaveButtonsVisibility() {
  const container = document.getElementById('save-buttons-container');
  const akademikContainer = document.getElementById('akademik-buttons-container');
  if (activeTab === 'akademik') {
    container.classList.add('hidden');
    akademikContainer.classList.remove('hidden');
  } else {
    container.classList.remove('hidden');
    akademikContainer.classList.add('hidden');
  }
}

